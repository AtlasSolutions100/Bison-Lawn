# Deployment environment. Copy to .env.deploy on the server and fill in.
# .env.deploy is gitignored — it holds live secrets.

# Postgres password for the bundled db container (any long random string).
POSTGRES_PASSWORD=

# Host port the app binds on 127.0.0.1. Change it if 8080 is already taken by
# whatever else this VPS is running.
APP_HOST_PORT=8080

# The public origin. Must be HTTPS in production — the server refuses to start
# without it, and estimate accept/decline links are built from it.
APP_PUBLIC_URL=https://bisonlawncare.workoptional.tech

# Clerk. Development keys work on a custom domain (with Clerk's dev banner and
# usage limits) — fine for a demo. Do NOT set VITE_CLERK_PROXY_URL with dev
# keys; proxying only works for Clerk production instances.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Permanent admin accounts. Both are non-demotable. Everyone else signs up as a
# contractor and an owner promotes them from /team.
APP_OWNER_EMAIL=
APP_SECONDARY_OWNER_EMAIL=

SESSION_SECRET=
LOG_LEVEL=info

# Outbound email. Whoever consents in scripts/google-oauth-setup.mjs becomes the
# visible sender — no From header is set, Gmail stamps the authenticated account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Shared secret for the Squarespace/web-request webhook. Leave blank until wired.
WEB_REQUEST_WEBHOOK_SECRET=

# Only when using docker-compose.proxy.yml. Use a DEDICATED network shared with
# the proxy, never another project's own network -- attaching this container to
# another project's network makes that project's `docker compose down` fail with
# "network in use".
#   docker network create web-proxy
#   docker network connect web-proxy <proxy-container>
PROXY_NETWORK=web-proxy
