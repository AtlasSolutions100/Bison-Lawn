# The block to APPEND to /home/deploy/takeoff/Caddyfile.
#
# Append it after the existing {$SITE_HOST} block. Do not modify that block, and
# do not replace the file. Caddy supports any number of site blocks; there is no
# global options block in that file, so a new site block at the end is all that
# is needed.
#
# Deliberately matches the house style of the file it is joining:
#   - `encode zstd gzip` in the same order
#   - `format console`, because these lines land in the SAME `docker logs
#     takeoff-caddy-1` stream. Mixing console and json output there would make
#     the live stack's logs harder to read during an incident.
#
# No transport read/write timeouts: those exist in the takeoff block for a
# measured reason (a 30m report.pdf render). Nothing here is slow, so the stock
# deadlines apply.
#
# 25MB body cap rather than takeoff's 512MB: this app has no large-upload route.
# The cap is a floor under memory, not a target.

bisonlawn.workoptional.tech {
	encode zstd gzip

	reverse_proxy bisonlawn-app:8080

	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format console
	}
}
