# Vhost for bisonlawn.workoptional.tech.
#
# This VPS already runs Caddy in a container (takeoff-caddy-1). Append this
# block to that Caddy's existing Caddyfile — do NOT start a second Caddy, and do
# not replace the file: the existing site's block has to stay.
#
# Because Caddy is containerised, it reaches this app by container name over a
# shared Docker network, not on 127.0.0.1. That requires starting this stack
# with docker-compose.proxy.yml (see DEPLOY.md).

bisonlawn.workoptional.tech {
	reverse_proxy bisonlawn-app:8080

	encode gzip zstd

	# Estimate PDFs are the largest thing that moves through here.
	request_body {
		max_size 25MB
	}

	log {
		output stdout
		format json
	}
}
