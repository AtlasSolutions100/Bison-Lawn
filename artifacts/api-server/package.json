{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:owner-access": "tsx --test test/ownerAccess.test.ts",
    "test:integration": "NODE_ENV=test tsx --test test/integration.test.ts",
    "test:extra-work": "NODE_ENV=test tsx --test test/extraWork.test.ts",
    "test:estimate-delivery": "tsx --test test/estimateDelivery.test.ts",
    "test:customer-message-delivery": "tsx --test test/customerMessageDelivery.test.ts",
    "test:automation": "NODE_ENV=test tsx --test test/automation.test.ts",
    "test:user-accounts": "NODE_ENV=test tsx --test test/userAccounts.test.ts",
    "test": "pnpm run test:owner-access && pnpm run test:estimate-delivery && pnpm run test:customer-message-delivery && pnpm run test:integration && pnpm run test:automation && pnpm run test:extra-work && pnpm run test:user-accounts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.57",
    "@clerk/shared": "^4.29.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@swc/helpers": "^0.5.23",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pdfkit": "^0.20.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
