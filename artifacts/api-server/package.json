{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "weather-check": "tsx src/jobs/dailyWeatherCheck.ts",
    "email-automations": "tsx src/jobs/dailyEmailAutomations.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:owner-access": "tsx --test test/ownerAccess.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:extra-work": "tsx --test test/extraWork.test.ts",
    "test:estimate-delivery": "tsx --test test/estimateDelivery.test.ts",
    "test:invoice-document": "tsx --test test/invoiceDocument.test.ts",
    "test:pricing": "tsx --test test/pricing.test.ts",
    "test:services": "tsx --test test/services.test.ts",
    "test:invitation-email": "tsx --test test/invitationEmail.test.ts",
    "test:client-email": "tsx --test test/clientEmail.test.ts",
    "test:customer-message-delivery": "tsx --test test/customerMessageDelivery.test.ts",
    "test:automation": "tsx --test test/automation.test.ts",
    "test:user-accounts": "tsx --test test/userAccounts.test.ts",
    "test:credit-and-schedule": "tsx --test test/creditAndSchedule.test.ts",
    "test:locations": "tsx --test test/locations.test.ts",
    "test:sms": "tsx --test test/sms.test.ts",
    "test:client-activity": "tsx --test test/clientActivity.test.ts",
    "test:clients-bulk": "tsx --test test/clientsBulk.test.ts",
    "test:client-account": "tsx --test test/clientAccount.test.ts",
    "test:dispatch-actions": "tsx --test test/dispatchActions.test.ts",
    "test:document-send": "tsx --test test/documentSend.test.ts",
    "test:automation-rules": "tsx --test test/automationRules.test.ts",
    "test:reports": "tsx --test test/reports.test.ts",
    "test:estimates": "tsx --test test/estimates.test.ts",
    "test:invoice-verify": "tsx --test test/invoiceVerify.test.ts",
    "test:client-services": "tsx --test test/clientServices.test.ts",
    "test:access": "tsx --test test/access.test.ts",
    "test": "pnpm run test:owner-access && pnpm run test:estimate-delivery && pnpm run test:customer-message-delivery && pnpm run test:invoice-document && pnpm run test:pricing && pnpm run test:services && pnpm run test:invitation-email && pnpm run test:client-email && pnpm run test:integration && pnpm run test:automation && pnpm run test:extra-work && pnpm run test:user-accounts && pnpm run test:credit-and-schedule && pnpm run test:clients-bulk && pnpm run test:client-account && pnpm run test:dispatch-actions && pnpm run test:document-send && pnpm run test:automation-rules && pnpm run test:client-activity && pnpm run test:locations && pnpm run test:sms && pnpm run test:reports && pnpm run test:access && pnpm run test:client-services && pnpm run test:invoice-verify && pnpm run test:estimates"
  },
  "dependencies": {
    "@clerk/express": "^2.1.57",
    "@clerk/shared": "^4.29.1",
    "@swc/helpers": "^0.5.23",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pdfkit": "^0.20.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
