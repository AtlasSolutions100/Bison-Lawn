# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/bisonlawn

# --- Ports (local dev; production uses PORT directly) ---
API_PORT=3001
WEB_PORT=5173
BASE_PATH=/

# --- Public origin ---
# The origin customers reach the app at. Used for the accept/decline links in
# estimate emails and for credentialed CORS. Required in production, and must be
# HTTPS there. Optional comma-separated extras (e.g. during a DNS cutover):
APP_PUBLIC_URL=http://localhost:5173
APP_EXTRA_ORIGINS=

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Only with a Clerk PRODUCTION instance on a custom domain. Proxying does not
# work for development instances — leave this unset in dev.
# VITE_CLERK_PROXY_URL=https://client.example.com/api/__clerk

# --- App ---
SESSION_SECRET=change-me
APP_OWNER_EMAIL=owner@example.com
APP_SECONDARY_OWNER_EMAIL=
LOG_LEVEL=info

# --- Outbound email (Gmail API) ---
# From a Google Cloud project with the Gmail API enabled and a "Desktop app"
# OAuth client. Mint the refresh token once:
#   node scripts/google-oauth-setup.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Optional integrations ---
# Shared secret for the Squarespace/web-request webhook
WEB_REQUEST_WEBHOOK_SECRET=

# --- Production only ---
# Where the built SPA lives, if not artifacts/bison-crm/dist/public relative to
# the API bundle. Leave unset for the standard layout.
# WEB_DIST_PATH=
