# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/bisonlawn

# --- Ports (local dev; production uses PORT directly) ---
API_PORT=3001
WEB_PORT=5173
BASE_PATH=/

# --- Public origin ---
# The origin customers reach the app at. Used for the accept/decline links in
# estimate emails and for credentialed CORS. Required in production, and must be
# HTTPS there. Optional comma-separated extras (e.g. during a DNS cutover):
APP_PUBLIC_URL=http://localhost:5173
APP_EXTRA_ORIGINS=

# --- Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Only with a Clerk PRODUCTION instance on a custom domain. Proxying does not
# work for development instances — leave this unset in dev.
# VITE_CLERK_PROXY_URL=https://client.example.com/api/__clerk

# --- App ---
APP_OWNER_EMAIL=owner@example.com
APP_SECONDARY_OWNER_EMAIL=
LOG_LEVEL=info

# --- Outbound email (Gmail API) ---
# From a Google Cloud project with the Gmail API enabled and a "Desktop app"
# OAuth client. Mint the refresh token once:
#   node scripts/google-oauth-setup.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Who gets emailed when someone submits in-app feedback. Leave blank to turn
# notifications off and rely on the /feedback page alone. Deliberately separate
# from APP_OWNER_EMAIL, which controls who may administer the app.
FEEDBACK_NOTIFY_EMAIL=

# --- QuickBooks (Intuit) ---
# Development keys reach Intuit's SANDBOX only. Set INTUIT_ENVIRONMENT=production
# once production keys are approved - an unknown value falls back to sandbox on
# purpose, so a typo can never point real credentials at the live host.
# The redirect URI below must be registered on the Intuit app dashboard exactly.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=sandbox
# INTUIT_REDIRECT_URI=https://your-host/api/quickbooks/callback

# --- Optional integrations ---
# Shared secret for the Squarespace/web-request webhook
WEB_REQUEST_WEBHOOK_SECRET=

# --- Texting (SMS) ---
# Off by default. With SMS_PROVIDER=none the app still logs nothing false: the
# Text button offers the phone's own Messages app and says the customer will
# see the real number. Switching to twilio needs a Twilio account, the office
# number bought there, and one masked number per contractor (set on the Team
# page). Point each number's messaging webhook at
#   ${APP_PUBLIC_URL}/api/public/sms/inbound
# Cost: about $1/month per number plus a fraction of a cent per text, and a
# one-time A2P 10DLC business registration (days to weeks, needs the EIN).
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The office's own texting number, E.164 (+12085550142)
SMS_OFFICE_NUMBER=

# --- Production only ---
# Where the built SPA lives, if not artifacts/bison-crm/dist/public relative to
# the API bundle. Leave unset for the standard layout.
# WEB_DIST_PATH=
